# Copy to .env and adjust. All variables are optional — RekAI runs out of the
# box with the keyless `echo` provider.

# General
REKAI_ENVIRONMENT=development
REKAI_LOG_LEVEL=INFO
# Shown as `name` in the root `/` service-info response.
# REKAI_APP_NAME=RekAI
# Timeout (seconds) for every outbound HTTP call to a provider (chat,
# streaming, embeddings). Raise it for slow local backends (e.g. Ollama on
# CPU with a large model).
REKAI_REQUEST_TIMEOUT_SECONDS=60.0
# Gateway auth: comma-separated client API keys. When set, /v1/* requires
# `Authorization: Bearer <key>`. Empty = open (no client auth).
# REKAI_API_KEYS=sk-rekai-abc123,sk-rekai-def456
# /metrics is open by default (for Prometheus scraping) even when the above is
# set, but it exposes a per-client cost/token breakdown. Set true to require
# the same Bearer key there too (no-op if REKAI_API_KEYS is empty).
REKAI_METRICS_REQUIRE_AUTH=false

# Runtime key management: add/revoke tenant keys via /admin/keys without a
# redeploy (on top of REKAI_API_KEYS above). Stored in the configured cache
# backend (Redis if set, else process-local — see docs/architecture.md).
REKAI_DYNAMIC_KEYS_ENABLED=false
# Unlike BYOK, dynamic keys ARE persisted server-side. Set this (a Fernet key —
# generate with `python -c "from rekai.security import generate_key as g; print(g())"`)
# to encrypt them at rest, e.g. if REKAI_REDIS_URL points at shared infra you
# don't fully trust. Unset (default) = stored as plaintext.
# REKAI_DYNAMIC_KEYS_ENCRYPTION_KEY=
# Shared secret for /admin/* (Authorization: Bearer <this>). Unset (default) =
# the admin API isn't registered at all. Still put it behind a firewall/VPN
# too — REKAI_ADMIN_RATE_LIMIT_* below is a backstop, not a substitute.
# REKAI_ADMIN_KEY=sk-rekai-admin-...
# Rate limit on /admin/* — unlike the tenant limit above, this counts *every*
# attempt (right or wrong key), since there's one shared secret to guess
# rather than a per-tenant one. On by default whenever REKAI_ADMIN_KEY is set.
REKAI_ADMIN_RATE_LIMIT_ENABLED=true
REKAI_ADMIN_RATE_LIMIT_REQUESTS=20
REKAI_ADMIN_RATE_LIMIT_WINDOW_SECONDS=60

# Prompt-injection guardrail (OWASP LLM01). Heuristic, opt-in. "block" rejects a
# flagged chat request with 403; "flag" adds an X-Guardrail-Flag header.
REKAI_GUARDRAILS_ENABLED=false
REKAI_GUARDRAILS_ACTION=block
# Output redaction (OWASP LLM02). Heuristic, opt-in: scrubs common secret/API-key
# patterns (sk-..., AKIA..., private key blocks, ...) from the assistant's reply
# on non-streamed /v1/chat before it reaches the client. Sets X-Redacted when it
# fires. Not applied to /v1/chat/stream (see docs/architecture.md).
REKAI_OUTPUT_REDACTION_ENABLED=false
# Log format: "text" (human-readable) or "json" (structured, one object per line)
REKAI_LOG_FORMAT=text

# Routing
REKAI_DEFAULT_PROVIDER=echo

# Reject /v1/* request bodies larger than this many bytes (0 disables).
REKAI_MAX_BODY_BYTES=1000000

# Per-client spend cap (opt-in). Once a client's cumulative cost (as tracked in
# usage_by_client) reaches this many USD, further /v1/* requests from that
# client get 402 until an operator resets metrics. Unset = no cap.
# REKAI_CLIENT_BUDGET_USD=5.00
# Per-key overrides for the above, e.g. "sk-a:5.00,sk-b:20.00". A key not
# listed here falls back to REKAI_CLIENT_BUDGET_USD.
# REKAI_CLIENT_BUDGETS_USD=
# Time-box the cap above to a fixed window instead of lifetime spend, e.g.
# 86400 for "$X per day" or 2592000 for "$X per 30 days". Unset (default) =
# lifetime-cumulative. Not persisted across a restart (see docs/architecture.md).
# REKAI_CLIENT_BUDGET_WINDOW_SECONDS=

# Fallback chain tried on upstream (5xx) errors. Ordered "provider:model" list;
# model is optional (defaults to the request model). e.g. "openai:gpt-4o-mini,echo"
REKAI_FALLBACK_ENABLED=false
REKAI_FALLBACK_TARGETS=

# Retry transient (5xx/timeout) upstream failures with exponential backoff +
# jitter before falling over. attempts is the total tries per target (1 = off).
REKAI_RETRY_MAX_ATTEMPTS=2
REKAI_RETRY_BASE_DELAY_SECONDS=0.5
REKAI_RETRY_MAX_DELAY_SECONDS=8.0

# After a provider 429s, skip it for a while (its Retry-After, else this
# default) so requests route to a healthy fallback instead of hammering it.
REKAI_PROVIDER_COOLDOWN_ENABLED=true
REKAI_PROVIDER_COOLDOWN_SECONDS=30.0
# A 429 parks a provider immediately; a bare 5xx needs this many consecutive
# failures (across separate requests, resets on any success) first — a
# lightweight circuit breaker so one bad request doesn't sideline a provider.
REKAI_CIRCUIT_BREAKER_THRESHOLD=3

# Idempotency-Key: replay the stored response for a repeated key for this long
# (seconds). Needs the cache backend; a no-op when caching is disabled.
REKAI_IDEMPOTENCY_TTL_SECONDS=86400

# Semantic cache: reuse a response when a prior prompt's embedding is within the
# cosine threshold (catches paraphrases). Opt-in; one embedding call per request,
# so use a real embeddings model. Process-local.
REKAI_SEMANTIC_CACHE_ENABLED=false
# REKAI_SEMANTIC_CACHE_MODEL=text-embedding-3-small
REKAI_SEMANTIC_CACHE_THRESHOLD=0.85
REKAI_SEMANTIC_CACHE_MAX_ENTRIES=1000

# Cache (leave REKAI_REDIS_URL unset to use the in-memory cache)
REKAI_CACHE_ENABLED=true
REKAI_CACHE_TTL_SECONDS=3600
# REKAI_REDIS_URL=redis://localhost:6379/0

# Metrics persistence (write-behind to Redis; only active when REKAI_REDIS_URL is set)
REKAI_METRICS_PERSIST_INTERVAL_SECONDS=30

# Rate limiting. With REKAI_REDIS_URL set the budget is shared across
# workers/nodes (Redis INCR); without it, each process counts independently.
REKAI_RATE_LIMIT_ENABLED=true
REKAI_RATE_LIMIT_REQUESTS=60
REKAI_RATE_LIMIT_WINDOW_SECONDS=60

# Override or extend rekai/pricing.py's built-in USD-per-1M-token table without
# a code change, e.g. "gpt-4o:2.00:8.00,my-model:0.50:1.50" (prefix:input:output).
# An entry for an existing prefix replaces it. Drives cost estimates, budget
# caps, and the `pricing` field in /v1/models.
# REKAI_PRICING_OVERRIDES=

# Provider keys (optional server-side defaults; BYOK via X-Provider-Key overrides)
# REKAI_OPENAI_API_KEY=sk-...
REKAI_OPENAI_BASE_URL=https://api.openai.com/v1
REKAI_OLLAMA_BASE_URL=http://localhost:11434
# REKAI_ANTHROPIC_API_KEY=sk-ant-...
REKAI_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
REKAI_ANTHROPIC_VERSION=2023-06-01
REKAI_ANTHROPIC_DEFAULT_MAX_TOKENS=1024
# REKAI_GEMINI_API_KEY=...
REKAI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# A custom OpenAI-compatible backend (Groq, Together, OpenRouter, Mistral,
# vLLM, LM Studio, …). Set REKAI_CUSTOM_BASE_URL to enable it. Select it with
# provider="<name>" (or REKAI_DEFAULT_PROVIDER).
REKAI_CUSTOM_NAME=custom
# REKAI_CUSTOM_BASE_URL=https://api.groq.com/openai/v1
# REKAI_CUSTOM_API_KEY=...
# REKAI_CUSTOM_MODELS=llama-3.1-70b-versatile,mixtral-8x7b-32768
# REKAI_CUSTOM_EMBEDDING_MODELS=nomic-embed-text-v1.5,bge-large-en

# CORS (comma-separated origins, or *)
REKAI_CORS_ORIGINS=*

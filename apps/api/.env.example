# Copy to .env and adjust. All variables are optional — RekAI runs out of the
# box with the keyless `echo` provider.

# General
REKAI_ENVIRONMENT=development
REKAI_LOG_LEVEL=INFO
# Log format: "text" (human-readable) or "json" (structured, one object per line)
REKAI_LOG_FORMAT=text

# Routing
REKAI_DEFAULT_PROVIDER=echo

# Reject /v1/* request bodies larger than this many bytes (0 disables).
REKAI_MAX_BODY_BYTES=1000000

# Fallback chain tried on upstream (5xx) errors. Ordered "provider:model" list;
# model is optional (defaults to the request model). e.g. "openai:gpt-4o-mini,echo"
REKAI_FALLBACK_ENABLED=false
REKAI_FALLBACK_TARGETS=

# Retry transient (5xx/timeout) upstream failures with exponential backoff +
# jitter before falling over. attempts is the total tries per target (1 = off).
REKAI_RETRY_MAX_ATTEMPTS=2
REKAI_RETRY_BASE_DELAY_SECONDS=0.5
REKAI_RETRY_MAX_DELAY_SECONDS=8.0

# After a provider 429s, skip it for a while (its Retry-After, else this
# default) so requests route to a healthy fallback instead of hammering it.
REKAI_PROVIDER_COOLDOWN_ENABLED=true
REKAI_PROVIDER_COOLDOWN_SECONDS=30.0

# Cache (leave REKAI_REDIS_URL unset to use the in-memory cache)
REKAI_CACHE_ENABLED=true
REKAI_CACHE_TTL_SECONDS=3600
# REKAI_REDIS_URL=redis://localhost:6379/0

# Metrics persistence (write-behind to Redis; only active when REKAI_REDIS_URL is set)
REKAI_METRICS_PERSIST_INTERVAL_SECONDS=30

# Rate limiting
REKAI_RATE_LIMIT_ENABLED=true
REKAI_RATE_LIMIT_REQUESTS=60
REKAI_RATE_LIMIT_WINDOW_SECONDS=60

# Provider keys (optional server-side defaults; BYOK via X-Provider-Key overrides)
# REKAI_OPENAI_API_KEY=sk-...
REKAI_OPENAI_BASE_URL=https://api.openai.com/v1
REKAI_OLLAMA_BASE_URL=http://localhost:11434
# REKAI_ANTHROPIC_API_KEY=sk-ant-...
REKAI_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
REKAI_ANTHROPIC_VERSION=2023-06-01
REKAI_ANTHROPIC_DEFAULT_MAX_TOKENS=1024
# REKAI_GEMINI_API_KEY=...
REKAI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# A custom OpenAI-compatible backend (Groq, Together, OpenRouter, Mistral,
# vLLM, LM Studio, …). Set REKAI_CUSTOM_BASE_URL to enable it. Select it with
# provider="<name>" (or REKAI_DEFAULT_PROVIDER).
REKAI_CUSTOM_NAME=custom
# REKAI_CUSTOM_BASE_URL=https://api.groq.com/openai/v1
# REKAI_CUSTOM_API_KEY=...
# REKAI_CUSTOM_MODELS=llama-3.1-70b-versatile,mixtral-8x7b-32768
# REKAI_CUSTOM_EMBEDDING_MODELS=nomic-embed-text-v1.5,bge-large-en

# CORS (comma-separated origins, or *)
REKAI_CORS_ORIGINS=*
